# Copy to .env and set strong passwords. .env is gitignored - never commit it.
# On Windows, save this file with LF (not CRLF) line endings.

# SYS / SYSTEM / PDBADMIN password for the database. ORDS also uses it once,
# to install itself and APEX. Rules: 8+ chars, upper, lower and a digit.
ORACLE_PWD=Change_Me_123

# Password for ORDS_PUBLIC_USER, the account behind the ORDS connection pool.
ORDS_PUBLIC_PWD=Change_Me_321

# Password for APEX_PUBLIC_USER (the account ORDS uses to serve APEX).
APEX_PUBLIC_PWD=Change_Me_456

# Password for the APEX instance administrator (INTERNAL workspace, user ADMIN).
# Applied by scripts/set-admin-password.sh after the first start - the APEX
# silent installer otherwise leaves a well-known default on this account.
APEX_ADMIN_PWD=Change_Me_789!

# Host ports. Change these if 1521 or 8080 are already taken on your machine.
DB_PORT=1521
ORDS_PORT=8080

# Which APEX download scripts/get-apex.* fetches:
#   full = all languages (needed for a translated APEX Builder, e.g. Arabic)
#   en   = English only (smaller)
APEX_EDITION=full